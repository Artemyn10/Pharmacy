@model Pharmacy.Models.ViewModels.SaleDetailsViewModel
@using Pharmacy.Models

@{
    ViewData["Title"] = $"Продажа #{Model.Id}";
}

<h1 class="h3 mb-3">Заказ №@Model.Id</h1>
<div class="d-flex flex-wrap gap-2 no-print">
    <a asp-action="ReceiptText"
       asp-route-id="@Model.Id"
       class="btn btn-outline-success">
        Скачать чек .txt
    </a>
    <button type="button" class="btn btn-success" onclick="window.print()">
        Печать
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">
        К списку продаж
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Дата</dt>
            <dd class="col-sm-9">@Model.SaleDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Пользователь</dt>
            <dd class="col-sm-9">
                @Model.UserFullName
                @if (!string.IsNullOrWhiteSpace(Model.UserName))
                {
                    <span class="text-muted">(@Model.UserName)</span>
                }
            </dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white">
        <thead>
            <tr>
                <th>Товар</th>
                <th class="text-end">Количество</th>
                <th class="text-end">Цена</th>
                <th class="text-end">Сумма</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.MedicineName</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@item.Price.ToString("N2") руб.</td>
                    <td class="text-end">@item.TotalPrice.ToString("N2") руб.</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Итого:</th>
                <th class="text-end">@Model.TotalAmount.ToString("N2") руб.</th>
            </tr>
        </tfoot>
    </table>
</div>

@if (Model.Status == SaleStatuses.Completed)
{
    <form asp-action="Cancel"
          asp-route-id="@Model.Id"
          method="post"
          class="mt-4 no-print"
          onsubmit="return confirm('Отменить заказ и вернуть товары на склад?');">
        <button type="submit" class="btn btn-outline-danger">
            Отменить заказ
        </button>
    </form>
}