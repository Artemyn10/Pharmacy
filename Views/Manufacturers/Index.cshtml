@model List<Pharmacy.Models.Manufacturer>
@{
    ViewData["Title"] = "Производители";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Производители</h1>
    <div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">← В панель</a>
        <a asp-action="Create" class="btn btn-success">+ Добавить производителя</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Производителей пока нет. Нажмите «Добавить производителя».</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Страна</th>
                        <th>Описание</th>
                        <th class="text-center">Товаров</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@m.Name</td>
                            <td>@m.Country</td>
                            <td>@m.Description</td>
                            <td class="text-center"><span class="badge bg-secondary">@m.Medicines.Count</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm">Изменить</a>

                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Удалить этого производителя?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}