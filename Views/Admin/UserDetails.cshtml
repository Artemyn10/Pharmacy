@model Pharmacy.Models.ViewModels.AdminUserListItemViewModel

@{
    ViewData["Title"] = "Пользователь";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Пользователь</h1>
    <a asp-action="Users" class="btn btn-outline-secondary">← К списку</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ФИО</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Логин</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Роль</dt>
            <dd class="col-sm-9">@Model.Role</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Активен" : "Отключён")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        <a asp-action="EditUser"
           asp-route-id="@Model.Id"
           class="btn btn-success">Изменить</a>
    </div>
</div>