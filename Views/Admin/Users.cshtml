@model List<Pharmacy.Models.ViewModels.AdminUserListItemViewModel>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Пользователи</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← В панель</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Пользователей пока нет.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ФИО</th>
                        <th>Логин</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Активен</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Отключён</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="UserDetails"
                                   asp-route-id="@user.Id"
                                   class="btn btn-outline-primary btn-sm">Просмотр</a>
                                <a asp-action="EditUser"
                                   asp-route-id="@user.Id"
                                   class="btn btn-outline-success btn-sm">Изменить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}