@model List<Pharmacy.Models.ViewModels.CustomerOrderListItemViewModel>

@{
    var isClient = User.IsInRole(Pharmacy.Models.RoleNames.Client);
    ViewData["Title"] = isClient ? "Мои заказы" : "Заказы клиентов";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    @if (isClient)
    {
        <a asp-action="Create" class="btn btn-success">+ Новый заказ</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        @(isClient ? "У вас пока нет заказов." : "Новых заказов нет.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white">
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Дата</th>
                    @if (!isClient)
                    {
                        <th>Клиент</th>
                    }
                    <th>Позиций</th>
                    <th class="text-end">Сумма</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        @if (!isClient)
                        {
                            <td>@order.CustomerName</td>
                        }
                        <td>@order.ItemCount</td>
                        <td class="text-end">@order.TotalAmount.ToString("N2") руб.</td>
                        <td>@order.Status</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-success">Открыть</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}