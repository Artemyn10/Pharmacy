@model Pharmacy.Models.ViewModels.CustomerOrderDetailsViewModel
@using Pharmacy.Models

@{
    ViewData["Title"] = $"Заказ #{Model.Id}";
}

<div class="d-flex flex-wrap gap-2 no-print">
    <a asp-action="ReceiptText"
       asp-route-id="@Model.Id"
       class="btn btn-outline-success">
        Скачать чек .txt
    </a>
    <button type="button" class="btn btn-success" onclick="window.print()">
        Печать
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">
        Назад к заказам
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Дата</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
            <dt class="col-sm-3">Клиент</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>
            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white">
        <thead>
            <tr>
                <th>Товар</th>
                <th class="text-end">Количество</th>
                <th class="text-end">Цена</th>
                <th class="text-end">Сумма</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.MedicineName</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@item.UnitPrice.ToString("N2") руб.</td>
                    <td class="text-end">@item.TotalPrice.ToString("N2") руб.</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Итого:</th>
                <th class="text-end">@Model.TotalAmount.ToString("N2") руб.</th>
            </tr>
        </tfoot>
    </table>
</div>

@if (Model.IsStaff && Model.Status == CustomerOrderStatuses.New)
{
    <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
        <input type="hidden" name="newStatus" value="@CustomerOrderStatuses.Processing" />
        <button type="submit" class="btn btn-primary">Взять в обработку</button>
    </form>
}

@if (Model.IsStaff && Model.Status == CustomerOrderStatuses.Processing)
{
    <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
        <input type="hidden" name="newStatus" value="@CustomerOrderStatuses.Completed" />
        <button type="submit" class="btn btn-success">Завершить заказ</button>
    </form>
}

@if (Model.CanCancel)
{
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-danger"
                onclick="return confirm('Отменить заказ? Зарезервированный остаток вернётся на склад.')">
            Отменить заказ
        </button>
    </form>
}