@model Pharmacy.Models.Medicine
@{
    // Цена и дата выводятся в формате, который понимают поля number и date в браузере
    var priceText = Model.Price > 0
        ? Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
        : "";
    var dateText = Model.ExpirationDate.ToString("yyyy-MM-dd");
}

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="0">-- Выберите категорию --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="ManufacturerId" class="form-label"></label>
        <select asp-for="ManufacturerId" asp-items="ViewBag.Manufacturers" class="form-select">
            <option value="0">-- Выберите производителя --</option>
        </select>
        <span asp-validation-for="ManufacturerId" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="SupplierId" class="form-label"></label>
        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
            <option value="0">-- Выберите поставщика --</option>
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" value="@priceText" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" type="number" min="0" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="ExpirationDate" class="form-label"></label>
        <input asp-for="ExpirationDate" type="date" value="@dateText" class="form-control" />
        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Barcode" class="form-label"></label>
    <input asp-for="Barcode" class="form-control" />
    <span asp-validation-for="Barcode" class="text-danger"></span>
</div>

<div class="form-check mb-2">
    <input asp-for="PrescriptionRequired" class="form-check-input" />
    <label asp-for="PrescriptionRequired" class="form-check-label"></label>
</div>

<div class="form-check mb-4">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Активен (отображается в каталоге)</label>
</div>