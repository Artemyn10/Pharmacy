@model List<Pharmacy.Models.Medicine>
@using Pharmacy.Models
@{
    ViewData["Title"] = "Управление товарами";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Управление товарами</h1>
    <div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">← В панель</a>
        <a asp-action="Create" class="btn btn-success">+ Добавить товар</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Товаров пока нет. Нажмите «Добавить товар».</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Категория</th>
                        <th class="text-end">Цена</th>
                        <th class="text-center">Остаток</th>
                        <th>Срок годности</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr class="@(m.IsActive ? "" : "table-secondary")">
                            <td>
                                <a asp-action="Details" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@m.Name</a>
                                @if (m.PrescriptionRequired)
                                {
                                    <span class="badge bg-secondary ms-1">Рецепт</span>
                                }
                            </td>
                            <td>@m.Category?.Name</td>
                            <td class="text-end text-nowrap">@m.Price.ToString("N2") руб.</td>
                            <td class="text-center">
                                <span class="badge @MedicineRules.GetStockBadgeClass(m.Quantity)">@m.Quantity</span>
                            </td>
                            <td class="text-nowrap">@m.ExpirationDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (m.IsActive)
                                {
                                    <span class="badge bg-success">Активен</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">Деактивирован</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm">Изменить</a>

                                <form asp-action="ToggleActive" asp-route-id="@m.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                        @(m.IsActive ? "Деактивировать" : "Активировать")
                                    </button>
                                </form>

                                <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-outline-danger btn-sm">Удалить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}