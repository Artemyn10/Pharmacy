@model List<Pharmacy.Models.Category>
@{
    ViewData["Title"] = "Категории";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Категории</h1>
    <div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">← В панель</a>
        <a asp-action="Create" class="btn btn-success">+ Добавить категорию</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Категорий пока нет. Нажмите «Добавить категорию».</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th class="text-center">Товаров</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td>@c.Description</td>
                            <td class="text-center"><span class="badge bg-secondary">@c.Medicines.Count</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">Изменить</a>

                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Удалить эту категорию?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}